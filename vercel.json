{
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "codex/**": false,
      "claude/lucid-sagan-bbciuo": true
    }
  },
  "buildCommand": "node scripts/migrate.mjs && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__path=:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/handler?__path=.well-known/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "node scripts/vercel-ignore.mjs"
}
