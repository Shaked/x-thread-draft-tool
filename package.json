{
  "name": "x-thread-draft-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:api": "vitest run tests/api",
    "db:migrate": "node scripts/migrate.mjs --strict",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "vite build --mode production",
    "test:budget": "node scripts/test-budget.mjs",
    "precommit:checks": "npm run docs:refresh && npm run lint && npm run test:unit",
    "prepare": "git config core.hooksPath .githooks || true",
    "docs:refresh": "node scripts/update-claude-index.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "smoke": "node scripts/smoke.mjs",
    "agent:login": "node scripts/agent-login.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.1.2",
    "@emoji-mart/react": "^1.1.1",
    "@vercel/blob": "^2.8.2",
    "idb-keyval": "^6.2.1",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/ui": "4.1.12",
    "jsdom": "29.1.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
