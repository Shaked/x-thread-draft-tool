# Copy to .env.local and fill in. .env.local is gitignored via the *.local rule.
# Used only by local diagnostic scripts (npm run metrics:report / metrics:tail).
# The frontend has its own VITE_SUPABASE_* vars in .env (or .env.local).

# Same value as VITE_SUPABASE_URL. Public, but keeping a copy here keeps the
# scripts independent of how Vite loads env.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Token used to read aggregated metrics via /functions/v1/metrics.
# Set this on the server with:
#   supabase secrets set METRICS_TOKEN="<long-random>" --project-ref <ref>
# Then mirror the same value here. Rotate by re-running the secrets set.
METRICS_TOKEN=

# Service role key — required only by `npm run metrics:tail` to read raw rows.
# Bypasses RLS. NEVER commit this. NEVER expose it to the browser.
# Find it in Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
